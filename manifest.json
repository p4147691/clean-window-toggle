{
  "manifest_version": 3,
  "name": "Clean Window Toggle",
  "version": "2.3.24",
  "description": "주소창과 탭바를 숨기고 작은 Chrome 창 안에서 집중해서 보며, 한 탭 창에서도 원래 Chrome 창 정체성을 안정적으로 보존합니다.",
  "permissions": [
    "tabs",
    "storage",
    "scripting",
    "tabGroups",
    "activeTab"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Clean Window로 전환",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "commands": {
    "toggle-clean-window": {
      "suggested_key": {
        "default": "Alt+C",
        "windows": "Alt+C"
      },
      "description": "Clean Window 모드 전환"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "fullscreen_guard.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "windowed_fullscreen.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
