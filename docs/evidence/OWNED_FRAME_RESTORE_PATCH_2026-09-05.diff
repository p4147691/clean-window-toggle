+async function restoreOwnedFrameIfNeeded(session) {
+  // Current 2.3.24 mode 3 does not hide the native Chrome frame. Legacy/defensive
+  // restore calls must therefore never target whichever unrelated Chrome window
+  // happens to be foreground. Only restore when this session explicitly owns a
+  // previously hidden frame.
+  if (session?.frameHidden !== true) return { ok: true, skipped: "frame-not-hidden" };
+  const response = await nativeWindowRequest("restoreCleanWindowFrame");
+  if (response?.ok) session.frameHidden = false;
+  return response;
+}
